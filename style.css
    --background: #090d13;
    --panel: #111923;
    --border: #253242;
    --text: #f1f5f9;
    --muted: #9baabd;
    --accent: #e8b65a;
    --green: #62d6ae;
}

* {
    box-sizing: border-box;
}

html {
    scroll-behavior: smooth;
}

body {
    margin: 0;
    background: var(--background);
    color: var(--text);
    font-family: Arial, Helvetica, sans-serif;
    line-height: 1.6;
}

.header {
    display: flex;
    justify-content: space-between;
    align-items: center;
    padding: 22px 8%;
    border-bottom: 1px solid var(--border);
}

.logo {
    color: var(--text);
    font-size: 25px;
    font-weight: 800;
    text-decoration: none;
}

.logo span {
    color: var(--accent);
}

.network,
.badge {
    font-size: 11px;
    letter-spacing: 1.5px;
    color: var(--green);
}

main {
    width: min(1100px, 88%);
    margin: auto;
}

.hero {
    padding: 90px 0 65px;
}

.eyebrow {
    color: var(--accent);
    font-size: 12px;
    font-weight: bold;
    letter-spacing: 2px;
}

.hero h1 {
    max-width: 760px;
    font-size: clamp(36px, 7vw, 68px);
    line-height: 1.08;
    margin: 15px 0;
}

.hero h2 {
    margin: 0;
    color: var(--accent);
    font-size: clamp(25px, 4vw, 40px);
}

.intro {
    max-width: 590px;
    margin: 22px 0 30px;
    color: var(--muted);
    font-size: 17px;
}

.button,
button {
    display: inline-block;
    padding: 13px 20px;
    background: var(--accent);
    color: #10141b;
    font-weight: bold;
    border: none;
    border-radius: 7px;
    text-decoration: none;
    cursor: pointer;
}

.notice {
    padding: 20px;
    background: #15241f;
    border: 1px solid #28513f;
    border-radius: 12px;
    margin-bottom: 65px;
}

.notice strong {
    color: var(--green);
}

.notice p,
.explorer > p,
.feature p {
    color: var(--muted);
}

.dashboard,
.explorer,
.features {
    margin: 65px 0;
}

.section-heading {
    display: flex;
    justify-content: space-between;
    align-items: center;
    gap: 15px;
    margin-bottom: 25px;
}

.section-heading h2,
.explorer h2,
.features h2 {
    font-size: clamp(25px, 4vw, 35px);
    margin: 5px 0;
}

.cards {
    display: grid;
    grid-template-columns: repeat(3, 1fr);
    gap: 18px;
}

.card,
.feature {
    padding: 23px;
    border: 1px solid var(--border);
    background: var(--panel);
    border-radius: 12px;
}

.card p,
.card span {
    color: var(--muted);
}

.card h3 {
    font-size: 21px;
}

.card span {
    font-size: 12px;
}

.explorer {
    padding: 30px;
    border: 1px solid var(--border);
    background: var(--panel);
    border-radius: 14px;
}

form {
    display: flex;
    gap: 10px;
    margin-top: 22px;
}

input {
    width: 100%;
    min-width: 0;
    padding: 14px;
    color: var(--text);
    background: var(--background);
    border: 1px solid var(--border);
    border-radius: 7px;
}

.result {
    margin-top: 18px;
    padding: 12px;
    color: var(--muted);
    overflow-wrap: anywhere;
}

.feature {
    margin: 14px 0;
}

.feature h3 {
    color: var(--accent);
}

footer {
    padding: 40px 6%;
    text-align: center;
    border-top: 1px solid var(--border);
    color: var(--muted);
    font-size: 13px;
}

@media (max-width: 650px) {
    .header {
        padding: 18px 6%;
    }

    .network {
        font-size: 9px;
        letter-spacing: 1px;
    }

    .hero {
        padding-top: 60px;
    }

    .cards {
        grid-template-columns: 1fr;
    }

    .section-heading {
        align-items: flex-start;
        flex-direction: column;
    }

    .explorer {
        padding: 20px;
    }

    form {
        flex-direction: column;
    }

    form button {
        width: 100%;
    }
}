:root {
    --background: #090d13;
    --panel: #111923;
    --border: #253242;
    --text: #f1f5f9;
    --muted: #9baabd;
    --accent: #e8b65a;
    --green: #62d6ae;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 8%;
    border-bottom: 1px solid var(--border);
}

.logo {
    color: var(--text);
    font-size: 25px;
    font-weight: 800;
    text-decoration: none;
}

.logo span {
    color: var(--accent);
}

.network,
.badge {
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--green);
}

main {
    width: min(1100px, 88%);
    margin: auto;
}

.hero {
    padding: 90px 0 65px;
}

.eyebrow {
    color: var(--accent);
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
}

.hero h1 {
    max-width: 760px;
    font-size: clamp(36px, 7vw, 68px);
    line-height: 1.08;
    margin: 15px 0;
}

.hero h2 {
    margin: 0;
    color: var(--accent);
    font-size: clamp(25px, 4vw, 40px);
}

.intro {
    max-width: 590px;
    margin: 22px 0 30px;
    color: var(--muted);
    font-size: 17px;
}

.button,
button {
    display: inline-block;
    padding: 13px 20px;
    background: var(--accent);
    color: #10141b;
    font-weight: bold;
    border: none;
    border-radius: 7px;
    text-decoration: none;
    cursor: pointer;
}

.notice {
    padding: 20px;
    background: #15241f;
    border: 1px solid #28513f;
    border-radius: 12px;
    margin-bottom: 65px;
}

.notice strong {
    color: var(--green);
}

.notice p,
.explorer > p,
.feature p {
    color: var(--muted);
}

.dashboard,
.explorer,
.features {
    margin: 65px 0;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
}

.section-heading h2,
.explorer h2,
.features h2 {
    font-size: clamp(25px, 4vw, 35px);
    margin: 5px 0;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.card,
.feature {
    padding: 23px;
    border: 1px solid var(--border);
    background: var(--panel);
    border-radius: 12px;
}

.card p,
.card span {
    color: var(--muted);
}

.card h3 {
    font-size: 21px;
}

.card span {
    font-size: 12px;
}

.explorer {
    padding: 30px;
    border: 1px solid var(--border);
    background: var(--panel);
    border-radius: 14px;
}

form {
    display: flex;
    gap: 10px;
    margin-top: 22px;
}

input {
    width: 100%;
    min-width: 0;
    padding: 14px;
    color: var(--text);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 7px;
}

.result {
    margin-top: 18px;
    padding: 12px;
    color: var(--muted);
    overflow-wrap: anywhere;
}

.feature {
    margin: 14px 0;
}

.feature h3 {
    color: var(--accent);
}

footer {
    padding: 40px 6%;
    text-align: center;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 13px;
}

@media (max-width: 650px) {
    .header {
        padding: 18px 6%;
    }

    .network {
        font-size: 9px;
        letter-spacing: 1px;
    }

    .hero {
        padding-top: 60px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .explorer {
        padding: 20px;
    }

    form {
        flex-direction: column;
    }

    form button {
        width: 100%;
    }
}